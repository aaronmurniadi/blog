# --- Internal "Clean" Backend ---
:8002 {
	# Bind to localhost so this port isn't exposed to the internet
	bind 127.0.0.1

	root * /home/aaron/blog/_site

	# Speed optimizations from before
	encode zstd gzip
	file_server

	# Optional: Aggressive Caching
	@static path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2
	header @static Cache-Control "public, max-age=31536000"

	# Any missing file is served as 410 Gone so stale URLs drop out of search
	# indices quickly. Serve the styled 410 page but override the status.
	handle_errors {
		@notfound status 404
		handle @notfound {
			rewrite * /410.html
			file_server
			status 410
			header X-Robots-Tag "noindex"
		}
	}
